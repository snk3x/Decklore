<Project Sdk="Microsoft.NET.Sdk">

	<!-- Decklore for Android phones. Shares card lookups, prices, deck rules and guides with the Windows app (Core). -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>TcgMobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Decklore</ApplicationTitle>
		<ApplicationId>com.snk3x.tcgdeckscanner</ApplicationId>
		<ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- Include 32-bit ARM so older and budget phones (like the LG K30) can install it, not only 64-bit ones. -->
		<RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Release builds are signed with the owner's permanent key when it's on this computer (it is never in the repository).
	     The password comes from the TCG_KEYSTORE_PASS environment variable, set only for the build. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(TCG_KEYSTORE_PASS)' != '' And Exists('$(USERPROFILE)\TCG deck scanner signing\tcgdeckscanner.keystore')">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(USERPROFILE)\TCG deck scanner signing\tcgdeckscanner.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>tcgdeckscanner</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>env:TCG_KEYSTORE_PASS</AndroidSigningStorePass>
		<AndroidSigningKeyPass>env:TCG_KEYSTORE_PASS</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- Use the Android SDK and Java installed in the user profile, when present. -->
	<PropertyGroup>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\jdk')">$(LOCALAPPDATA)\Android\jdk</JavaSdkDirectory>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#182040" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#182040" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\TcgCore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.2" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
	</ItemGroup>

</Project>
