<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by the Windows and Android apps: card databases, prices, deck rules, starter decks, guides, card-text parsing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>TcgScanner</RootNamespace>
    <AssemblyName>TcgCore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
