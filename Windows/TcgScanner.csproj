<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TCG deck scanner</AssemblyName>
    <RootNamespace>TcgScanner</RootNamespace>
    <Product>TCG deck scanner</Product>
    <AssemblyTitle>TCG deck scanner</AssemblyTitle>
    <Version>1.1.0</Version>
    <ApplicationIcon>Card icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TcgCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />  </ItemGroup>

</Project>
